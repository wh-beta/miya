<view class="page">
  <view class="header">
    <text class="greeting">{{greeting}}</text>
    <text class="app-name">课后助手</text>
  </view>

  <view class="menu-list">
    <view class="menu-card" bindtap="onViewTaskCalendar">
      <view class="menu-text">
        <text class="menu-title">学习任务</text>
        <text class="menu-desc">查看作业与课程，跟踪完成进度</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-card" bindtap="onManageAccount">
      <view class="menu-text">
        <text class="menu-title">账号与学生绑定</text>
        <text class="menu-desc">设置姓名，关联孩子的账号</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-card" bindtap="onSetReminder">
      <view class="menu-text">
        <text class="menu-title">设置提醒</text>
        <text class="menu-desc">开启作业到期提醒</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-card" bindtap="onFindSimilarQuestions">
      <view class="menu-text">
        <text class="menu-title">查找相似题</text>
        <text class="menu-desc">拍一道题或上传PDF，找同类练习</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <bottom-nav active="directory" role="{{role}}" />
</view>
