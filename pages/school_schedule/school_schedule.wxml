<view class="page">
  <view class="header">
    <text class="title">课程表</text>
    <button size="mini" class="action-btn import-btn" bindtap="onGoImport">📥 导入</button>
  </view>

  <view wx:if="{{loading && groups.length === 0}}" class="empty-state">加载中...</view>

  <view wx:elif="{{groups.length === 0}}" class="empty-state">
    你还没有任何班级课程表。点击右上角"导入"拍照识别一张课程表，或手动创建一个班级。
  </view>

  <block wx:else>
    <view class="chip-row" wx:if="{{groups.length > 1}}">
      <view
        wx:for="{{groups}}"
        wx:key="id"
        class="chip {{item.id === currentGroupId ? 'active' : ''}}"
        data-id="{{item.id}}"
        data-label="{{item.school}} {{item.grade}}{{item.class_name}}"
        data-owner="{{item.is_owner}}"
        bindtap="onSwitchGroup"
      >{{item.school}} {{item.grade}}{{item.class_name}}{{item.is_owner ? '' : ' (受邀)'}}</view>
    </view>

    <view class="group-label" wx:if="{{currentGroupLabel}}">
      <text>{{currentGroupLabel}}</text>
      <text class="role-tag" wx:if="{{!canEdit}}">受邀查看</text>
    </view>

    <view class="action-row">
      <button wx:if="{{canEdit && !editing}}" size="mini" class="action-btn edit-btn" bindtap="onToggleEdit">✏️ 编辑</button>
      <block wx:if="{{canEdit && editing}}">
        <button size="mini" class="action-btn cancel-btn" bindtap="onToggleEdit">取消</button>
        <button size="mini" class="action-btn save-btn" bindtap="onSave">保存</button>
      </block>
      <button wx:if="{{canEdit && !editing}}" size="mini" class="action-btn regen-btn" bindtap="onRegenerateInvite">🔄 重置邀请码</button>
      <button wx:if="{{canEdit && !editing}}" size="mini" class="action-btn invite-btn" open-type="share">🔗 邀请加入</button>
      <button size="mini" class="action-btn share-btn" bindtap="onShareSchedule">📤 一键共享</button>
    </view>

    <scroll-view scroll-x class="table-scroll">
      <view class="schedule-table">
        <view class="table-row header-row">
          <view class="table-cell period-cell"></view>
          <view wx:for="{{days}}" wx:key="*this" class="table-cell day-cell-h">{{item}}</view>
        </view>
        <view class="table-row" wx:for="{{grid}}" wx:for-item="row" wx:for-index="pIdx" wx:key="pIdx">
          <view class="table-cell period-cell">{{pIdx + 1}}</view>
          <view class="table-cell subject-cell" wx:for="{{row}}" wx:for-item="subj" wx:for-index="dIdx" wx:key="dIdx">
            <input
              wx:if="{{editing}}"
              class="subject-input"
              value="{{subj}}"
              data-period="{{pIdx + 1}}"
              data-day="{{dIdx + 1}}"
              bindinput="onCellInput"
              placeholder="—"
            />
            <text wx:else class="{{subj ? '' : 'placeholder'}}">{{subj || '—'}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>

  <canvas
    type="2d"
    id="scheduleShareCanvas"
    class="share-canvas"
    style="width:{{shareCanvasWidth}}px;height:{{shareCanvasHeight}}px;"
  ></canvas>

  <bottom-nav active="directory" role="{{role}}" />
</view>
