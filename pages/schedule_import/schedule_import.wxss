.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  padding: 24rpx;
}

.header {
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #24302A;
}

.step-indicator {
  display: block;
  font-size: 22rpx;
  color: #8B978C;
  margin-top: 6rpx;
}

.step-block {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hint-card {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: #5B6A5F;
  line-height: 1.6;
}

.hint-text {
  text-align: center;
  font-size: 24rpx;
  color: #8B978C;
  padding: 20rpx 0;
}

.primary-btn {
  background: #1F8F82;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 16rpx;
}

.secondary-btn {
  background: #EEF4E9;
  color: #5B6A5F;
  font-size: 26rpx;
  border-radius: 16rpx;
}

.nav-row {
  display: flex;
  gap: 16rpx;
}

.nav-row .secondary-btn,
.nav-row .primary-btn {
  flex: 1;
}

.table-scroll {
  width: 100%;
}

.schedule-table {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 20rpx;
  overflow: hidden;
  min-width: 100%;
}

.table-row {
  display: flex;
}

.header-row {
  background: #1F8F82;
}

.table-cell {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 18rpx 6rpx;
  border-bottom: 1rpx solid #EEF2EA;
}

.table-row:last-child .table-cell {
  border-bottom: none;
}

.period-cell {
  width: 64rpx;
  min-width: 64rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #5B6A5F;
}

.header-row .period-cell {
  color: transparent;
}

.day-cell-h {
  flex: 1;
  min-width: 120rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}

.subject-cell {
  flex: 1;
  min-width: 120rpx;
  font-size: 24rpx;
  color: #24302A;
}

.table-row:nth-child(even) .subject-cell,
.table-row:nth-child(even) .period-cell {
  background: #F8FAF6;
}

.subject-input {
  width: 100%;
  text-align: center;
  font-size: 24rpx;
  color: #24302A;
  background: #EEF4E9;
  border-radius: 8rpx;
  padding: 6rpx 0;
}

.seg {
  display: flex;
  background: #EEF4E9;
  border: 1rpx solid #DCE6D6;
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #5B6A5F;
  padding: 12rpx 0;
  border-radius: 999rpx;
}

.seg-btn.active {
  background: #1F8F82;
  color: #fff;
}

.search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}

.search-btn {
  color: #146E64;
  background: #DCF0EA;
  font-size: 24rpx;
  margin: 0;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.group-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 16rpx;
  padding: 20rpx;
}

.group-item.active {
  border-color: #1F8F82;
  border-width: 2rpx;
  background: #F0F9F6;
}

.group-item-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.group-item-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #24302A;
}

.group-item-owner {
  font-size: 22rpx;
  color: #8B978C;
}

.group-item-tag {
  font-size: 20rpx;
  color: #C97F1F;
  background: #FBEBD4;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.form-input {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
}
