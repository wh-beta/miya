.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  padding: 0 24rpx 140rpx;
}

.placeholder {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding-bottom: 140rpx;
}

.icon {
  font-size: 80rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #24302A;
}

.desc {
  font-size: 24rpx;
  color: #8B978C;
}
