.container {
  padding: 32rpx 24rpx;
  background: #F6F9F2;
  min-height: 100vh;
  box-sizing: border-box;
}

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #5B6A5F;
  letter-spacing: 0.05em;
  margin: 32rpx 0 12rpx;
}

.section-label:first-child {
  margin-top: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field-input {
  flex: 1;
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.field-hint {
  display: block;
  font-size: 20rpx;
  color: #8B978C;
  margin-top: 8rpx;
}

.code-card {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 8rpx;
}

.code-text {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #146E64;
  margin: 8rpx 0;
}

.hint {
  font-size: 22rpx;
  color: #8B978C;
  margin-bottom: 16rpx;
  text-align: center;
}

.code-actions {
  display: flex;
  gap: 16rpx;
}

.student-row {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.student-row-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.student-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #EEF4E9;
}

.student-code-text {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #146E64;
}

.student-code-copy {
  font-size: 20rpx;
  color: #5B6A5F;
  background: #EEF4E9;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.unlink-btn {
  background: #FCE4DF;
  color: #D8503C;
}

.virtual-tag {
  font-size: 18rpx;
  font-weight: 600;
  color: #8B978C;
  background: #EEF4E9;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
}

.or-divider {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #8B978C;
  margin: 16rpx 0;
}

.empty {
  display: block;
  color: #8B978C;
  font-size: 24rpx;
  font-style: italic;
}

.go-home-btn {
  margin-top: 48rpx;
}

.privacy-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(36, 48, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.privacy-box {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.privacy-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #24302A;
  margin-bottom: 16rpx;
}

.privacy-text {
  font-size: 25rpx;
  color: #5B6A5F;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.privacy-link {
  color: #1F8F82;
  font-weight: 600;
}

.privacy-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
