.container {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  gap: 80rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.title {
  font-size: 64rpx;
  font-weight: 800;
  color: #146E64;
  letter-spacing: 0.02em;
}

.tagline {
  font-size: 24rpx;
  color: #8B978C;
}

.role-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #5B6A5F;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.role-btn {
  width: 100%;
  background: #DCF0EA;
  color: #146E64;
  border: none;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 28rpx 0;
  line-height: normal;
}

.role-btn::after {
  border: none;
}

.role-btn:active {
  background: #C7E6DC;
}
