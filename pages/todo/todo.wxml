<view class="page">
  <text class="page-title">待办</text>

  <view class="task-list">
    <view wx:for="{{items}}" wx:key="key" class="task-card">
      <view class="task-top">
        <text class="task-title">{{item.title}}</text>
        <view class="task-meta">
          <text class="tag">{{item.subject}}</text>
          <text wx:if="{{role === 'parent' && item.childName}}" class="child-tag">{{item.childName}}</text>
          <text wx:if="{{item.metaRight}}" class="meta-text">{{item.metaRight}}</text>
          <text wx:if="{{role === 'student' && item.urged}}" class="urge-pill">提醒完成</text>
        </view>
      </view>
      <view class="task-bottom">
        <button
          size="mini"
          class="status-btn status-{{item.status}}"
          data-kind="{{item.kind}}"
          data-id="{{item.id}}"
          bindtap="onToggleStatus"
        >{{item.statusLabel}}</button>
        <view class="row-actions">
          <button size="mini" data-kind="{{item.kind}}" data-id="{{item.id}}" bindtap="onAddToCalendar">加入日历</button>
          <button
            wx:if="{{role === 'parent'}}"
            size="mini"
            class="{{item.urged ? 'urged-btn' : ''}}"
            data-kind="{{item.kind}}"
            data-id="{{item.id}}"
            bindtap="onUrge"
          >{{item.urged ? '已催办' : '催办'}}</button>
          <button wx:if="{{role === 'parent'}}" size="mini" data-kind="{{item.kind}}" data-id="{{item.id}}" bindtap="onDelete">删除</button>
        </view>
      </view>
    </view>
    <view wx:if="{{items.length === 0 && role === 'parent' && linkedStudents.length === 0}}" class="empty-note-link" bindtap="onGoToAccountLink">还没有关联学生，去"账号与绑定"添加一个吧 ›</view>
    <text wx:elif="{{items.length === 0}}" class="empty-note">暂无待办任务，都完成啦</text>
  </view>

  <bottom-nav active="todo" role="{{role}}" />
  <fireworks id="fireworks" />
</view>
