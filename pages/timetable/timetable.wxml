<view class="container">
  <text class="title">课程表</text>

  <button bindtap="onUploadSchedulePhoto" loading="{{uploadingSchedule}}">上传课表照片</button>

  <view wx:if="{{scheduleDrafts.length > 0}}" class="draft-section">
    <view class="section-header">
      <text class="section-title">识别结果 ({{scheduleDrafts[0].child_name}})，请逐个添加到日历</text>
      <button size="mini" bindtap="onAddAllSessions" loading="{{addingAllSchedule}}">一键保存全部（不含日历）</button>
    </view>
    <view wx:for="{{scheduleDrafts}}" wx:key="index" class="draft-row">
      <view class="draft-info">
        <text>{{item.subject}}</text>
        <text class="draft-detail">{{item.session_date}} {{item.start_time}}-{{item.end_time}}</text>
        <text wx:if="{{item.note}}" class="draft-note">{{item.note}}</text>
      </view>
      <button
        size="mini"
        type="{{item.status === 'added' ? '' : 'primary'}}"
        disabled="{{item.status === 'added'}}"
        loading="{{item.status === 'adding'}}"
        data-idx="{{index}}"
        bindtap="onAddSession"
      >{{item.status === 'added' ? '已添加' : (item.status === 'saved' ? '添加到日历' : '添加')}}</button>
    </view>
  </view>

  <view class="saved-section">
    <text class="section-title">已保存的课程</text>
    <view wx:for="{{saved}}" wx:key="id" class="saved-row">
      <text class="saved-info">{{item.session_date}} {{item.start_time}}-{{item.end_time}} {{item.subject}}{{item.child_name ? ' · ' + item.child_name : ''}}</text>
      <button
        size="mini"
        type="{{item.calStatus === 'added' ? '' : 'primary'}}"
        disabled="{{item.calStatus === 'added'}}"
        loading="{{item.calStatus === 'adding'}}"
        data-idx="{{index}}"
        bindtap="onAddSavedSessionToCalendar"
      >{{item.calStatus === 'added' ? '已加日历' : '添加到日历'}}</button>
      <button size="mini" data-id="{{item.id}}" bindtap="onDeleteSaved">删除</button>
    </view>
    <text wx:if="{{saved.length === 0}}" class="empty">暂无已保存课程</text>
  </view>

  <view class="saved-section">
    <text class="section-title">已保存的作业</text>
    <view wx:for="{{savedTasks}}" wx:key="id" class="saved-row">
      <text class="saved-info">{{item.due_at}} {{item.title}}{{item.subject ? ' · ' + item.subject : ''}}{{item.child_name ? ' · ' + item.child_name : ''}}</text>
      <button
        size="mini"
        type="{{item.calStatus === 'added' ? '' : 'primary'}}"
        disabled="{{item.calStatus === 'added'}}"
        loading="{{item.calStatus === 'adding'}}"
        data-idx="{{index}}"
        bindtap="onAddSavedTaskToCalendar"
      >{{item.calStatus === 'added' ? '已加日历' : '添加到日历'}}</button>
    </view>
    <text wx:if="{{savedTasks.length === 0}}" class="empty">暂无已保存作业</text>
  </view>

  <button bindtap="onUploadTaskListPhoto" loading="{{uploadingTasks}}">上传作业清单照片</button>

  <view wx:if="{{taskDrafts.length > 0}}" class="draft-section">
    <view class="section-header">
      <text class="section-title">识别结果 ({{taskDrafts[0].child_name}})，请逐个添加为作业</text>
      <button size="mini" bindtap="onAddAllTasks" loading="{{addingAllTasks}}">一键保存全部（不含日历）</button>
    </view>
    <view wx:for="{{taskDrafts}}" wx:key="index" class="draft-row">
      <view class="draft-info">
        <text>{{item.title}}</text>
        <text class="draft-detail">{{item.subject}} · {{item.due_at}}</text>
      </view>
      <button
        size="mini"
        type="{{item.status === 'added' ? '' : 'primary'}}"
        disabled="{{item.status === 'added'}}"
        loading="{{item.status === 'adding'}}"
        data-idx="{{index}}"
        bindtap="onAddTask"
      >{{item.status === 'added' ? '已添加' : (item.status === 'saved' ? '添加到日历' : '添加')}}</button>
    </view>
  </view>

  <view wx:if="{{showNameModal}}" class="modal-overlay">
    <view class="modal-box">
      <text class="modal-title">这些内容是哪个孩子的？</text>
      <view wx:if="{{children.length > 0}}" class="name-chips">
        <view wx:for="{{children}}" wx:key="*this" class="name-chip" data-name="{{item}}" bindtap="onPickExistingName">{{item}}</view>
      </view>
      <input class="modal-input" placeholder="输入姓名" value="{{nameInput}}" bindinput="onNameInput" />
      <view class="modal-actions">
        <button size="mini" bindtap="onCancelNameModal">取消</button>
        <button size="mini" type="primary" bindtap="onConfirmName">确定</button>
      </view>
    </view>
  </view>
</view>
