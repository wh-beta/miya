.container {
  padding: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.section-title {
  font-weight: bold;
  margin: 24rpx 0 12rpx;
  display: block;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-header .section-title {
  margin: 24rpx 0 12rpx 0;
}

.draft-section,
.saved-section {
  margin-top: 16rpx;
}

.draft-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.draft-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.draft-detail {
  font-size: 24rpx;
  color: #666;
}

.draft-note {
  font-size: 22rpx;
  color: #999;
}

.saved-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #eee;
}

.saved-info {
  flex: 1;
  font-size: 26rpx;
}

.empty {
  color: #999;
  font-size: 24rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-box {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-weight: bold;
  margin-bottom: 20rpx;
}

.name-chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.name-chip {
  padding: 8rpx 20rpx;
  background: #f0f0f0;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 26rpx;
}

.modal-input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 12rpx;
  margin-bottom: 20rpx;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
}

.modal-actions button {
  margin-left: 16rpx;
}
