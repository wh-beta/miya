<view class="page">
  <view class="header">
    <text class="title">为{{studentName}}添加记录</text>
  </view>

  <text class="section-label">科目</text>
  <view class="pill-select">
    <view
      wx:for="{{subjects}}"
      wx:key="*this"
      class="pill {{selectedSubject === item ? 'active' : ''}}"
      data-subject="{{item}}"
      bindtap="onSelectSubject"
    >{{item}}</view>
  </view>
  <input class="field-input" placeholder="或输入自定义科目" bindinput="onCustomSubjectInput" />

  <text class="section-label">考试名称（可选）</text>
  <input class="field-input" placeholder="如：期中考试、单元测验" value="{{examName}}" bindinput="onExamNameInput" />

  <text class="section-label">分数（可选）</text>
  <view class="score-row">
    <input class="field-input score-input" type="digit" placeholder="分数" value="{{score}}" bindinput="onScoreInput" />
    <text class="score-sep">/</text>
    <input class="field-input score-input" type="digit" placeholder="满分" value="{{maxScore}}" bindinput="onMaxScoreInput" />
  </view>

  <text class="section-label">日期</text>
  <picker mode="date" value="{{recordDate}}" bindchange="onDateChange">
    <view class="date-pick">{{recordDate}}</view>
  </picker>

  <text class="section-label">备注（可选）</text>
  <textarea class="textarea" placeholder="任何想记录的内容" value="{{note}}" bindinput="onNoteInput" maxlength="-1" />

  <text class="section-label">练习卷/试卷照片（可选）</text>
  <view wx:if="{{imagePath}}" class="image-preview-row">
    <image class="image-preview" src="{{imagePath}}" mode="aspectFill" />
    <text class="remove-image-link" bindtap="onRemoveImage">移除</text>
  </view>
  <button wx:else size="mini" class="choose-image-btn" bindtap="onChooseImage">📷 拍照或从相册选择</button>

  <button class="save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存</button>
</view>
