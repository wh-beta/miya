.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  padding: 24rpx 24rpx 60rpx;
}

.header {
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #24302A;
}

.section-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: #8B978C;
  margin: 28rpx 0 12rpx;
}

.section-label:first-of-type {
  margin-top: 0;
}

.pill-select {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pill {
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #DCE6D6;
  background: #fff;
  color: #5B6A5F;
}

.pill.active {
  background: #24302A;
  color: #fff;
  border-color: #24302A;
}

.field-input {
  margin-top: 12rpx;
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-input {
  flex: 1;
  margin-top: 0;
}

.score-sep {
  font-size: 28rpx;
  color: #8B978C;
}

.date-pick {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #24302A;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  min-height: 120rpx;
}

.choose-image-btn {
  color: #146E64;
  background: #DCF0EA;
  margin: 0;
}

.image-preview-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.image-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #EEF4E9;
}

.remove-image-link {
  font-size: 24rpx;
  color: #D8503C;
}

.save-btn {
  margin-top: 48rpx;
  background: #1F8F82;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 16rpx;
}
