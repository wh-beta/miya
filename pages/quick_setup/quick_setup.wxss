.container {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  gap: 60rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  color: #146E64;
  letter-spacing: 0.02em;
}

.tagline {
  font-size: 24rpx;
  color: #8B978C;
}

.loading-hint {
  font-size: 24rpx;
  color: #8B978C;
}

.name-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-input {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.field-hint {
  font-size: 20rpx;
  color: #8B978C;
}

.save-btn {
  margin-top: 16rpx;
  background: #1F8F82;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 16rpx;
}

.privacy-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(36, 48, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.privacy-box {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.privacy-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #24302A;
  margin-bottom: 16rpx;
}

.privacy-text {
  font-size: 25rpx;
  color: #5B6A5F;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.privacy-link {
  color: #1F8F82;
  font-weight: 600;
}

.privacy-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
