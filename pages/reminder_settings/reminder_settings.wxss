.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  padding: 24rpx 24rpx 200rpx;
}

.header {
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #24302A;
}

.hint-card {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: #5B6A5F;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.primary-btn {
  background: #1F8F82;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 16rpx;
}
