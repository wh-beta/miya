@import "../../styles/task_card.wxss";

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  padding: 24rpx 24rpx 200rpx;
  position: relative;
}

.section-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: #8B978C;
  margin: 28rpx 0 12rpx;
}

.section-label:first-child {
  margin-top: 0;
}

.seg {
  display: flex;
  background: #EEF4E9;
  border: 1rpx solid #DCE6D6;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}

.seg-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #5B6A5F;
  padding: 12rpx 0;
  border-radius: 999rpx;
}

.seg-btn.active {
  background: #1F8F82;
  color: #fff;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 20rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.pager-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  border-radius: 16rpx;
  background: #EEF4E9;
  color: #24302A;
}

.pager-mid {
  flex: 1;
  text-align: center;
}

.pager-date {
  font-size: 30rpx;
  font-weight: 700;
}

.pager-sub {
  font-size: 22rpx;
  color: #8B978C;
  margin-top: 4rpx;
}

.today-chip {
  color: #146E64;
  background: #DCF0EA;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-left: 8rpx;
  font-size: 20rpx;
}

.month-calendar {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  position: relative;
  margin-bottom: 8rpx;
}

.month-label {
  font-size: 28rpx;
  font-weight: 700;
  min-width: 150rpx;
  text-align: center;
}

.month-today-chip {
  position: absolute;
  right: 0;
}

.weekday-row {
  display: flex;
}

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #8B978C;
  padding: 8rpx 0;
}

.week-row {
  display: flex;
}

.day-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 78rpx;
}

.day-num {
  font-size: 26rpx;
  color: #24302A;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
}

.day-cell.out-month .day-num {
  color: #C5D0BE;
}

.day-cell.is-today .day-num {
  color: #1F8F82;
  font-weight: 700;
}

.day-cell.is-selected .day-num {
  background: #1F8F82;
  color: #fff;
  font-weight: 700;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #E8A33D;
  margin-top: 2rpx;
}

.day-cell.is-selected .day-dot {
  background: #1F8F82;
}

.month-selected-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 2rpx 16rpx;
}

.month-selected-label text:first-child {
  font-size: 26rpx;
  font-weight: 700;
}

.month-selected-count {
  font-size: 22rpx;
  color: #8B978C;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chip {
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #DCE6D6;
  background: #fff;
  color: #5B6A5F;
}

.chip.active {
  background: #24302A;
  color: #fff;
  border-color: #24302A;
}

.chip.all {
  background: #DCF0EA;
  color: #146E64;
  border-color: transparent;
}

.chip.all.active {
  background: #DCF0EA;
  color: #146E64;
  border: 3rpx solid #1F8F82;
}

.progress-card {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 24rpx;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.range-row {
  display: flex;
  gap: 8rpx;
}

.range-btn {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  padding: 10rpx 0;
  border-radius: 12rpx;
  background: #EEF4E9;
  color: #5B6A5F;
}

.range-btn.active {
  background: #24302A;
  color: #fff;
}

.custom-range-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-pick {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx 0;
  border-radius: 12rpx;
  background: #EEF4E9;
  color: #24302A;
}

.range-sep {
  font-size: 22rpx;
  color: #8B978C;
}

.ratio-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.ratio-num {
  font-size: 44rpx;
  font-weight: 800;
}

.ratio-num.small {
  font-size: 32rpx;
}

.ratio-den {
  font-size: 24rpx;
  color: #8B978C;
}

.bar-track {
  height: 14rpx;
  border-radius: 8rpx;
  background: #E4ECDC;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #1F8F82;
  border-radius: 8rpx;
}

.child-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #EEF2EA;
}

.child-row:first-child {
  border-top: none;
  padding-top: 0;
}

.child-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.child-name {
  font-size: 26rpx;
  font-weight: 700;
}

.trend {
  font-size: 22rpx;
  font-weight: 700;
}

.trend.up {
  color: #2F9A63;
}

.trend.down {
  color: #D8503C;
}

.trend.flat {
  color: #8B978C;
}

.share-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}

.share-btn {
  font-size: 22rpx;
  font-weight: 700;
  color: #146E64;
  background: #DCF0EA;
  margin: 0;
  padding: 8rpx 22rpx;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 190rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1F8F82;
  color: #fff;
  font-size: 56rpx;
  line-height: 100rpx;
  text-align: center;
  padding: 0;
  box-shadow: 0 10rpx 30rpx rgba(31, 143, 130, 0.4);
}
