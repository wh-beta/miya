.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  padding: 24rpx 24rpx 200rpx;
}

.header {
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #24302A;
}

.menu-list {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #EEF4E9;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-row:active {
  background: #F8FAF6;
}

.menu-label {
  font-size: 28rpx;
  color: #24302A;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C5D0BE;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #D8503C;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}
