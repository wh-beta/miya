<view class="page">
  <view class="header">
    <text class="title">身份设置</text>
  </view>

  <view wx:if="{{loading}}" class="loading-hint">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <view wx:if="{{hasConnection}}" class="locked-card">
      <text class="locked-status">当前身份：{{role === 'parent' ? '家长' : (role === 'student' ? '学生' : '未设置')}}</text>
      <text class="locked-hint">已存在关联关系，身份无法修改。如需修改，请先在"账号与学生绑定"中解除关联。</text>
    </view>

    <block wx:else>
      <text class="section-hint">选择你的身份 — 在你添加/绑定学生之前，可以随时更改。</text>
      <view class="role-list">
        <button
          class="role-btn {{role === 'parent' ? 'active' : ''}}"
          data-role="parent"
          bindtap="onPickRole"
          disabled="{{saving}}"
        >家长</button>
        <button
          class="role-btn {{role === 'student' ? 'active' : ''}}"
          data-role="student"
          bindtap="onPickRole"
          disabled="{{saving}}"
        >学生</button>
        <text class="claim-link" bindtap="onClaimCode">家长已经为我创建过账号？输入连接码</text>
      </view>
    </block>
  </block>

  <bottom-nav active="mine-role" role="{{role}}" />
</view>
