.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  padding: 24rpx 24rpx 200rpx;
}

.header {
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #24302A;
}

.loading-hint {
  font-size: 24rpx;
  color: #8B978C;
}

.locked-card {
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.locked-status {
  font-size: 28rpx;
  font-weight: 700;
  color: #24302A;
}

.locked-hint {
  font-size: 23rpx;
  color: #8B978C;
  line-height: 1.6;
}

.section-hint {
  display: block;
  font-size: 23rpx;
  color: #8B978C;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.role-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.role-btn {
  width: 100%;
  background: #fff;
  color: #24302A;
  border: 1rpx solid #DCE6D6;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 28rpx 0;
  line-height: normal;
}

.role-btn::after {
  border: none;
}

.role-btn.active {
  background: #DCF0EA;
  color: #146E64;
  border-color: #1F8F82;
}

.role-btn:active {
  background: #EEF4E9;
}

.claim-link {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8B978C;
}
