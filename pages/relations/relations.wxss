.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F9F2;
  padding: 32rpx 24rpx 140rpx;
}

.page-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #24302A;
  margin-bottom: 24rpx;
}

.relation-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.relation-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 1rpx solid #DCE6D6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #24302A;
}

.unlink-btn {
  background: #FCE4DF;
  color: #D8503C;
}

.virtual-tag {
  font-size: 18rpx;
  font-weight: 600;
  color: #8B978C;
  background: #EEF4E9;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
}

.empty {
  display: block;
  color: #8B978C;
  font-size: 24rpx;
  font-style: italic;
  text-align: center;
  padding: 40rpx 0;
}

.manage-link {
  color: #146E64;
  background: #DCF0EA;
  font-size: 22rpx;
  font-weight: 600;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-top: 24rpx;
  text-align: center;
}
