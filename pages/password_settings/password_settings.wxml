<view class="page">
  <view class="header">
    <text class="title">登录密码</text>
  </view>

  <view class="hint-card">
    {{name ? '为 ' + name + ' 设置密码，' : ''}}用于在其他手机上通过"切换账号"进入该身份。
  </view>

  <text class="field-label">新密码</text>
  <input class="field-input" password value="{{password}}" bindinput="onPasswordInput" placeholder="请输入新密码" />

  <text class="field-label">确认新密码</text>
  <input class="field-input" password value="{{confirmPassword}}" bindinput="onConfirmInput" placeholder="请再次输入新密码" />

  <button class="primary-btn" bindtap="onSave" loading="{{working}}" disabled="{{working}}">
    {{working ? '保存中...' : '保存'}}
  </button>

  <bottom-nav active="mine-password" role="{{role}}" />
</view>
