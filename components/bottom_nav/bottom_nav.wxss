.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #DCE6D6;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 10rpx;
  gap: 2rpx;
}

.nav-icon {
  font-size: 36rpx;
  color: #8B978C;
}

.nav-label {
  font-size: 20rpx;
  color: #8B978C;
}

.nav-item.active .nav-icon,
.nav-item.active .nav-label {
  color: #1F8F82;
  font-weight: 700;
}
