.poem-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(36, 48, 42, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.poem-card {
  width: 78%;
  background: #F6F9F2;
  border-radius: 24rpx;
  padding: 56rpx 48rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poem-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.poem-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #146E64;
  letter-spacing: 0.06em;
}

.poem-author {
  font-size: 22rpx;
  color: #8B978C;
}

.poem-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  min-height: 220rpx;
  justify-content: center;
}

.poem-line {
  font-size: 30rpx;
  color: #24302A;
  letter-spacing: 0.05em;
  animation: poem-line-in 0.6s ease;
}

@keyframes poem-line-in {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.poem-dots {
  display: flex;
  gap: 10rpx;
  margin-top: 32rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1F8F82;
  opacity: 0.35;
  animation: poem-dot-pulse 1.2s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes poem-dot-pulse {
  0%, 80%, 100% {
    opacity: 0.3;
  }
  40% {
    opacity: 1;
  }
}

.poem-hint {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: #8B978C;
}
