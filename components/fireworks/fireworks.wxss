.fw-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(20, 28, 22, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fw-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.fw-message {
  position: relative;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  background: rgba(31, 143, 130, 0.85);
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  letter-spacing: 0.02em;
}
